{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monk Mode AI",
  "version": "0.1.0",
  "identifier": "ai.monkmode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monk Mode AI",
        "width": 420,
        "height": 560,
        "resizable": true,
        "skipTaskbar": true
      }
    ]
  }
}

